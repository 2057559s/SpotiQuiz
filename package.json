{
  "name": "spotiquiz",
  "version": "1.0.0",
  "description": "A music quiz web app based on your Spotify listening history",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "dev:https": "concurrently \"next dev -p 3002\" \"sleep 2 && local-ssl-proxy --source 3443 --target 3002 --cert localhost.pem --key localhost-key.pem\"",
    "build": "next build",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "next start",
    "lint": "next lint"
  },
  "keywords": [
    "spotify",
    "quiz",
    "music"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^17.2.3",
    "next": "^14.0.0",
    "next-auth": "^4.24.13",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "spotify-web-api-js": "^1.5.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.5.6",
    "babel-plugin-react-compiler": "^0.0.0-experimental-21f75fd-20231027",
    "concurrently": "^9.2.1",
    "eslint": "^8.0.0",
    "eslint-config-next": "^14.0.0",
    "jsdom": "^25.0.1",
    "local-ssl-proxy": "^2.0.5",
    "tailwindcss": "^3.3.0",
    "typescript": "5.9.3",
    "vitest": "^2.1.9"
  }
}
